{
  "name": "cocoaauthor",
  "version": "1.0.0",
  "description": "Document authoring and publishing for the Cocoa suite.",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "desktop": "vite build && electron .",
    "dist": "vite build && electron-builder --publish never"
  },
  "author": "CocoaSuite",
  "license": "UNLICENSED",
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@tiptap/core": "^3.32.2",
    "@tiptap/extension-document": "^3.32.2",
    "@tiptap/extension-heading": "^3.32.2",
    "@tiptap/extension-highlight": "^3.32.2",
    "@tiptap/extension-link": "^3.32.2",
    "@tiptap/extension-paragraph": "^3.32.2",
    "@tiptap/extension-table": "^3.32.2",
    "@tiptap/extension-text-align": "^3.32.2",
    "@tiptap/extension-text-style": "^3.32.2",
    "@tiptap/extensions": "^3.32.2",
    "@tiptap/pm": "^3.32.2",
    "@tiptap/starter-kit": "^3.32.2",
    "docx": "^9.15.1",
    "fflate": "^0.8.3",
    "mammoth": "^1.13.0",
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/jetbrains-mono": "^0.4.1",
    "@expo-google-fonts/lora": "^0.4.2",
    "@expo-google-fonts/manrope": "^0.4.3",
    "@expo-google-fonts/playfair-display": "^0.4.2",
    "@expo-google-fonts/source-serif-4": "^0.4.2",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "productName": "CocoaAuthor",
  "private": true,
  "type": "module",
  "homepage": "https://github.com/CocoaSuite/CocoaAuthor",
  "build": {
    "appId": "com.cocoasuite.cocoaauthor",
    "productName": "CocoaAuthor",
    "copyright": "Copyright © CocoaSuite",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "fileAssociations": [
      {
        "ext": "cocoaauthor",
        "name": "CocoaAuthor Document",
        "description": "CocoaAuthor document",
        "mimeType": "application/x-cocoaauthor",
        "role": "Editor"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.png"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "icon": "build/icon.png",
      "maintainer": "CocoaSuite"
    },
    "publish": null
  }
}
